{
  "mcpServers": {
    "file-manager": {
      "command": "C:/Users/<user>/path/to/mcp-file-manager/.venv/Scripts/python.exe",
      "args": ["C:/Users/<user>/path/to/mcp-file-manager/server.py"],
      "env": {
        "MCP_FILE_BASE": "C:/Users/<user>/path/to/folder-yang-boleh-diakses"
      }
    }
  }
}
