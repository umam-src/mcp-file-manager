# Contoh environment variable untuk mcp-file-manager
# Copy ke .env dan sesuaikan nilai jika perlu.

# Direktori dasar yang boleh diakses MCP (keamanan).
# Semua operasi file dibatasi di dalam direktori ini.
# Path traversal keluar dari direktori ini akan ditolak.
MCP_FILE_BASE=/root

# Batas ukuran (byte) satu operasi write_file/append_file/edit_file.
# Default 5242880 (5 MiB).
# MCP_FILE_MAX_WRITE_BYTES=5242880

# Level log ke stderr (DEBUG, INFO, WARNING, ERROR). Default INFO.
# MCP_FILE_LOG_LEVEL=INFO
